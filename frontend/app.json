{
  "expo": {
    "name": "Lifeora",
    "slug": "lifeora",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#123C3A",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lifeora.app"
    },
    "android": {
      "package": "com.lifeora.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#123C3A"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lifeora lets you pick a photo that motivates you. It stays on your phone.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#123C3A"
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "extra": {
      "eas": {
        "projectId": "5f67c32c-54c0-44e1-9171-9031cf7f86db"
      }
    },
    "owner": "uroojmajeed",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5f67c32c-54c0-44e1-9171-9031cf7f86db",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
